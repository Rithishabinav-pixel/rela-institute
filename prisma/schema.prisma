// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Department {
  id             Int      @id @default(autoincrement())
  departmentId   Int      @unique
  name           String
  nameNormalized String   @unique
  slug           String?  @unique
  icon           String?
  showInHomepage Boolean  @default(false)
  centerOfExcellence Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  doctorLinks       DoctorDepartment[]
  doctorsSpeciality Doctor[]                 @relation("DoctorSpeciality")
  symptoms          DepartmentSymptom[]
  mediaArticles     MediaArticleDepartment[]
  successStories    SuccessStoryDepartment[]
  expertTalks       ExpertTalkDepartment[]
  events            EventDepartment[]
  wellnessNetwork    WellnessNetworkDepartment[]

  @@map("departments")
}

model DepartmentSymptom {
  id           Int      @id @default(autoincrement())
  departmentId Int
  name         String
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@map("department_symptoms")
}

model Doctor {
  id             Int      @id @default(autoincrement())
  slug           String   @unique
  name           String
  education      String
  position       String
  mainPosition   String
  image          String?
  specialityId   Int
  showInHomepage Boolean  @default(false)
  quickSearch    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  speciality     Department           @relation("DoctorSpeciality", fields: [specialityId], references: [id])
  departments    DoctorDepartment[]
  tabs           DoctorTab[]
  mediaArticles  MediaArticleDoctor[]
  successStories SuccessStoryDoctor[]
  expertTalks    ExpertTalkDoctor[]
  events         EventDoctor[]
  wellnessNetwork WellnessNetworkDoctor[]
  articles       DoctorArticle[]

  @@map("doctors")
}

model DoctorDepartment {
  doctorId     Int
  departmentId Int

  doctor     Doctor     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@id([doctorId, departmentId])
  @@map("doctor_departments")
}

model DoctorTab {
  id        Int      @id @default(autoincrement())
  doctorId  Int
  heading   String
  content   String   @db.Text
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@map("doctor_tabs")
}

model DoctorArticle {
  doctorId    Int
  articleSlug String
  createdAt   DateTime @default(now())

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@id([doctorId, articleSlug])
  @@map("doctor_articles")
}

model Media {
  id        Int      @id @default(autoincrement())
  fileName  String
  url       String
  altText   String
  mimeType  String?
  width     Int?
  height    Int?
  size      Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("media")
}

model MediaArticle {
  id                    Int       @id @default(autoincrement())
  title                 String
  slug                  String    @unique
  publishedAt           DateTime?
  featureType           String    @default("image")
  featureImage          String?
  featureImageSourceUrl String?
  youtubeUrl            String?
  readMoreUrl           String?
  pageLink              String?   @unique
  content               String?   @db.Text
  quickSearch           Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  departments MediaArticleDepartment[]
  doctors     MediaArticleDoctor[]
  gallery     MediaArticleGalleryImage[]

  @@map("media_articles")
}

model MediaArticleDepartment {
  mediaArticleId Int
  departmentId   Int

  mediaArticle MediaArticle @relation(fields: [mediaArticleId], references: [id], onDelete: Cascade)
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@id([mediaArticleId, departmentId])
  @@map("media_article_departments")
}

model MediaArticleDoctor {
  mediaArticleId Int
  doctorId       Int

  mediaArticle MediaArticle @relation(fields: [mediaArticleId], references: [id], onDelete: Cascade)
  doctor       Doctor       @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  @@id([mediaArticleId, doctorId])
  @@map("media_article_doctors")
}

model MediaArticleGalleryImage {
  id             Int      @id @default(autoincrement())
  mediaArticleId Int
  imagePath      String
  sourceUrl      String?
  altText        String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  mediaArticle MediaArticle @relation(fields: [mediaArticleId], references: [id], onDelete: Cascade)

  @@map("media_article_gallery_images")
}

model SuccessStory {
  id                    Int       @id @default(autoincrement())
  title                 String
  slug                  String    @unique
  publishedAt           DateTime?
  featureType           String    @default("image")
  featureImage          String?
  featureImageSourceUrl String?
  youtubeUrl            String?
  readMoreUrl           String?
  pageLink              String?   @unique
  content               String?   @db.Text
  quickSearch           Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  departments SuccessStoryDepartment[]
  doctors     SuccessStoryDoctor[]
  gallery     SuccessStoryGalleryImage[]

  @@map("success_stories")
}

model SuccessStoryDepartment {
  successStoryId Int
  departmentId   Int

  successStory SuccessStory @relation(fields: [successStoryId], references: [id], onDelete: Cascade)
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@id([successStoryId, departmentId])
  @@map("success_story_departments")
}

model SuccessStoryDoctor {
  successStoryId Int
  doctorId       Int

  successStory SuccessStory @relation(fields: [successStoryId], references: [id], onDelete: Cascade)
  doctor       Doctor       @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  @@id([successStoryId, doctorId])
  @@map("success_story_doctors")
}

model SuccessStoryGalleryImage {
  id             Int      @id @default(autoincrement())
  successStoryId Int
  imagePath      String
  sourceUrl      String?
  altText        String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  successStory SuccessStory @relation(fields: [successStoryId], references: [id], onDelete: Cascade)

  @@map("success_story_gallery_images")
}

model ExpertTalk {
  id                    Int       @id @default(autoincrement())
  title                 String
  slug                  String    @unique
  publishedAt           DateTime?
  featureType           String    @default("image")
  featureImage          String?
  featureImageSourceUrl String?
  youtubeUrl            String?
  readMoreUrl           String?
  pageLink              String?   @unique
  content               String?   @db.Text
  quickSearch           Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  departments ExpertTalkDepartment[]
  doctors     ExpertTalkDoctor[]
  gallery     ExpertTalkGalleryImage[]

  @@map("expert_talks")
}

model ExpertTalkDepartment {
  expertTalkId Int
  departmentId Int

  expertTalk ExpertTalk @relation(fields: [expertTalkId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@id([expertTalkId, departmentId])
  @@map("expert_talk_departments")
}

model ExpertTalkDoctor {
  expertTalkId Int
  doctorId     Int

  expertTalk ExpertTalk @relation(fields: [expertTalkId], references: [id], onDelete: Cascade)
  doctor     Doctor     @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  @@id([expertTalkId, doctorId])
  @@map("expert_talk_doctors")
}

model ExpertTalkGalleryImage {
  id           Int      @id @default(autoincrement())
  expertTalkId Int
  imagePath    String
  sourceUrl    String?
  altText      String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  expertTalk ExpertTalk @relation(fields: [expertTalkId], references: [id], onDelete: Cascade)

  @@map("expert_talk_gallery_images")
}

model WellnessNetwork {
  id                    Int       @id @default(autoincrement())
  title                 String
  slug                  String    @unique
  publishedAt           DateTime?
  featureType           String    @default("image")
  featureImage          String?
  featureImageSourceUrl String?
  youtubeUrl            String?
  readMoreUrl           String?
  pageLink              String?   @unique
  content               String?   @db.Text
  quickSearch           Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  departments WellnessNetworkDepartment[]
  doctors     WellnessNetworkDoctor[]
  gallery     WellnessNetworkGalleryImage[]

  @@map("wellness_network")
}

model WellnessNetworkDepartment {
  wellnessNetworkId Int
  departmentId      Int

  wellnessNetwork WellnessNetwork @relation(fields: [wellnessNetworkId], references: [id], onDelete: Cascade)
  department      Department      @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@id([wellnessNetworkId, departmentId])
  @@map("wellness_network_departments")
}

model WellnessNetworkDoctor {
  wellnessNetworkId Int
  doctorId          Int

  wellnessNetwork WellnessNetwork @relation(fields: [wellnessNetworkId], references: [id], onDelete: Cascade)
  doctor          Doctor          @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  @@id([wellnessNetworkId, doctorId])
  @@map("wellness_network_doctors")
}

model WellnessNetworkGalleryImage {
  id                Int      @id @default(autoincrement())
  wellnessNetworkId Int
  imagePath         String
  sourceUrl         String?
  altText           String?
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())

  wellnessNetwork WellnessNetwork @relation(fields: [wellnessNetworkId], references: [id], onDelete: Cascade)

  @@map("wellness_network_gallery_images")
}

model Event {
  id                    Int       @id @default(autoincrement())
  title                 String
  slug                  String    @unique
  publishedAt           DateTime?
  featureType           String    @default("image")
  featureImage          String?
  featureImageSourceUrl String?
  youtubeUrl            String?
  readMoreUrl           String?
  pageLink              String?   @unique
  content               String?   @db.Text
  quickSearch           Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  departments EventDepartment[]
  doctors     EventDoctor[]
  gallery     EventGalleryImage[]

  @@map("events")
}

model EventDepartment {
  eventId      Int
  departmentId Int

  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@id([eventId, departmentId])
  @@map("event_departments")
}

model EventDoctor {
  eventId  Int
  doctorId Int

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  @@id([eventId, doctorId])
  @@map("event_doctors")
}

model EventGalleryImage {
  id        Int      @id @default(autoincrement())
  eventId   Int
  imagePath String
  sourceUrl String?
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_gallery_images")
}

model HeroBanner {
  id            Int      @id @default(autoincrement())
  type          String   @default("content")
  title         String?
  fancyText     String?
  description   String?  @db.Text
  buttonText    String?
  buttonType    String?  @default("common")
  buttonLink    String?
  desktopImage  String?
  mobileImage   String?
  bannerLink    String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("hero_banners")
}

model JobTitle {
  id             Int      @id @default(autoincrement())
  name           String
  nameNormalized String   @unique
  createdAt      DateTime @default(now())

  jobs Job[]

  @@map("job_titles")
}

model JobCategory {
  id             Int      @id @default(autoincrement())
  name           String
  nameNormalized String   @unique
  createdAt      DateTime @default(now())

  jobs Job[]

  @@map("job_categories")
}

model JobLocation {
  id             Int      @id @default(autoincrement())
  name           String
  nameNormalized String   @unique
  createdAt      DateTime @default(now())

  jobs Job[]

  @@map("job_locations")
}

model Job {
  id            Int      @id @default(autoincrement())
  slug          String   @unique
  jobTitleId    Int
  jobCategoryId Int
  jobLocationId Int
  experience    String
  education     String
  content       String   @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  jobTitle    JobTitle    @relation(fields: [jobTitleId], references: [id], onDelete: Restrict)
  jobCategory JobCategory @relation(fields: [jobCategoryId], references: [id], onDelete: Restrict)
  jobLocation JobLocation @relation(fields: [jobLocationId], references: [id], onDelete: Restrict)
  careerEnquiries CareerEnquiry[]

  @@map("jobs")
}

model ContactEnquiry {
  id                Int      @id @default(autoincrement())
  name              String
  email             String
  phone             String
  preferredLocation String?
  lookingFor        String?
  message           String?  @db.Text
  pageUrl           String?
  emailStatus       String   @default("pending")
  createdAt         DateTime @default(now())

  @@map("contact_enquiries")
}

model CareerEnquiry {
  id                  Int      @id @default(autoincrement())
  name                String
  email               String
  phone               String
  jobId               Int?
  jobTitleSnapshot    String?
  jobCategorySnapshot String?
  jobLocationSnapshot String?
  resumePath          String?
  resumeOriginalName  String?
  message             String?  @db.Text
  pageUrl             String?
  emailStatus         String   @default("pending")
  createdAt           DateTime @default(now())

  job Job? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@map("career_enquiries")
}

model ContentEnquiry {
  id          Int      @id @default(autoincrement())
  name        String
  email       String
  phone       String
  country     String?
  state       String?
  enquiryType String?
  message     String?  @db.Text
  pageUrl     String?
  emailStatus String   @default("pending")
  createdAt   DateTime @default(now())

  @@map("content_enquiries")
}

model DoctorEnquiry {
  id          Int      @id @default(autoincrement())
  name        String
  email       String
  phone       String
  country     String?
  state       String?
  enquiryType String?
  message     String?  @db.Text
  pageUrl     String?
  emailStatus String   @default("pending")
  createdAt   DateTime @default(now())

  @@map("doctor_enquiries")
}

model HealthPackage {
  id              Int      @id @default(autoincrement())
  slug            String   @unique
  testName        String
  isPopular       Boolean  @default(false)
  discount        String?
  discountText    String?
  offerPrice      String
  actualPrice     String
  testCount       String
  disclaimer      String?
  ageGroup        String?
  gender          String?
  fastingFor      String?
  reportsWithin   String?
  packageImage    String?
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  testGroups HealthPackageTestGroup[]
  faqs       HealthPackageFaq[]
  enquiries  PackageEnquiry[]

  @@map("health_packages")
}

model HealthPackageTestGroup {
  id              Int    @id @default(autoincrement())
  healthPackageId Int
  heading         String
  sortOrder       Int    @default(0)

  healthPackage HealthPackage       @relation(fields: [healthPackageId], references: [id], onDelete: Cascade)
  tests         HealthPackageTest[]

  @@map("health_package_test_groups")
}

model HealthPackageTest {
  id        Int    @id @default(autoincrement())
  groupId   Int
  name      String
  sortOrder Int    @default(0)

  group HealthPackageTestGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("health_package_tests")
}

model HealthPackageFaq {
  id              Int      @id @default(autoincrement())
  healthPackageId Int
  heading         String
  answer          String   @db.Text
  sortOrder       Int      @default(0)

  healthPackage HealthPackage @relation(fields: [healthPackageId], references: [id], onDelete: Cascade)

  @@map("health_package_faqs")
}

model PackageEnquiry {
  id                  Int      @id @default(autoincrement())
  name                String
  email               String
  phone               String
  preferredLocation   String?
  message             String?  @db.Text
  packageId           Int?
  packageNameSnapshot String?
  packageSlugSnapshot String?
  pageUrl             String?
  emailStatus         String   @default("pending")
  createdAt           DateTime @default(now())

  package HealthPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@map("package_enquiries")
}

model Newsletter {
  id           Int       @id @default(autoincrement())
  title        String
  publishedAt  DateTime?
  featureImage String?
  pdfUrl       String?
  isActive     Boolean   @default(true)
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("newsletters")
}

model ResourceCategory {
  id            Int      @id @default(autoincrement())
  name          String
  slug          String   @unique
  categoryImage String?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  resources Resource[]

  @@map("resource_categories")
}

model Resource {
  id          Int      @id @default(autoincrement())
  title       String
  categoryId  Int
  linkType    String   @default("url")
  externalUrl String?
  pdfUrl      String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category ResourceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@map("resources")
}

model PatientExperienceCategory {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patientExperiences PatientExperience[]

  @@map("patient_experience_categories")
}

model PatientExperience {
  id           Int      @id @default(autoincrement())
  patientName  String
  categoryId   Int
  featureImage String?
  videoUrl     String
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category PatientExperienceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@map("patient_experiences")
}

model TestimonialCategory {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  testimonials Testimonial[]

  @@map("testimonial_categories")
}

model Testimonial {
  id              Int      @id @default(autoincrement())
  title           String
  content         String   @db.Text
  userName        String
  userImage       String?
  featureImage    String?
  categoryId      Int
  isInternational Boolean  @default(false)
  isFeatured      Boolean  @default(false)
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category TestimonialCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@map("testimonials")
}
